{
  "steps": [
    {
      "action": "press",
      "identifier": "bubble.left.and.text.bubble.right"
    },
    {
      "action": "press",
      "identifier": "chat.new.$project"
    },
    {
      "action": "press",
      "identifier": "chat.provider.codex"
    },
    {
      "action": "waitFor",
      "identifier": "chat.composer.send",
      "enabled": true,
      "timeout": 180
    },
    {
      "action": "type",
      "text": "Reply with only this word spelled backwards: nacilep"
    },
    {
      "action": "press",
      "identifier": "chat.composer.send"
    },
    {
      "action": "waitFor",
      "text": "Reply with only this word spelled backwards: nacilep",
      "within": "chat.composer.input",
      "absent": true,
      "timeout": 15
    },
    {
      "action": "waitFor",
      "text": "pelican",
      "within": "chat.transcript",
      "caseSensitive": true,
      "timeout": 180
    },
    {
      "action": "waitFor",
      "identifier": "chat.composer.stop",
      "timeout": 180,
      "absent": true
    },
    {
      "action": "dumpTree",
      "name": "before-local-switch",
      "delay": 3
    },
    {
      "action": "press",
      "identifier": "chat.provider.local"
    },
    {
      "action": "waitFor",
      "identifier": "chat.composer.send",
      "enabled": true,
      "timeout": 300
    },
    {
      "action": "type",
      "text": "Which word did you just reply with? Reply with only that word, in capitals."
    },
    {
      "action": "press",
      "identifier": "chat.composer.send"
    },
    {
      "action": "waitFor",
      "text": "Which word did you just reply with? Reply with only that word, in capitals.",
      "within": "chat.composer.input",
      "absent": true,
      "timeout": 300
    },
    {
      "action": "waitFor",
      "text": "PELICAN",
      "within": "chat.transcript",
      "caseSensitive": true,
      "timeout": 300
    },
    {
      "action": "waitFor",
      "identifier": "chat.composer.stop",
      "timeout": 300,
      "absent": true
    },
    {
      "action": "waitFor",
      "identifier": "chat.composer.send",
      "enabled": true,
      "timeout": 300
    },
    {
      "action": "type",
      "text": "Use your bash shell tool to run exactly: printf example > local-made.txt. Do not use an edit tool. Wait for approval."
    },
    {
      "action": "press",
      "identifier": "chat.composer.send"
    },
    {
      "action": "waitFor",
      "text": "Use your bash shell tool to run exactly: printf example > local-made.txt. Do not use an edit tool. Wait for approval.",
      "within": "chat.composer.input",
      "absent": true,
      "timeout": 300
    },
    {
      "action": "waitFor",
      "anyOf": [
        "chat.request.0.allow",
        "chat.question.0.0.option.0"
      ],
      "timeout": 300
    },
    {
      "action": "screenshot",
      "name": "local-approval"
    },
    {
      "action": "press",
      "identifier": "chat.question.0.0.option.0",
      "optional": true
    },
    {
      "action": "waitFor",
      "anyOf": [
        "chat.request.0.allow",
        "chat.request.0.submit"
      ],
      "enabled": true,
      "timeout": 300
    },
    {
      "action": "press",
      "anyOf": [
        "chat.request.0.allow",
        "chat.request.0.submit"
      ]
    },
    {
      "action": "waitFor",
      "identifier": "chat.request.0.submit",
      "timeout": 300,
      "absent": true
    },
    {
      "action": "waitFor",
      "timeout": 300,
      "anyOf": [
        "chat.request.0.allow",
        "chat.provider.local"
      ],
      "enabled": true
    },
    {
      "action": "press",
      "identifier": "chat.request.0.allow",
      "optional": true
    },
    {
      "action": "waitFor",
      "identifier": "chat.tool.completed",
      "within": "chat.transcript",
      "timeout": 300
    },
    {
      "action": "waitFor",
      "identifier": "chat.composer.stop",
      "timeout": 300,
      "absent": true
    },
    {
      "action": "waitFor",
      "identifier": "chat.composer.send",
      "enabled": true,
      "timeout": 300
    },
    {
      "action": "type",
      "text": "Use your question tool now to ask me which color to use. Ask exactly one question with options Blue and Green. Do not answer it yourself. After my answer, reply with only COLOR-CHOICE-DONE."
    },
    {
      "action": "press",
      "identifier": "chat.composer.send"
    },
    {
      "action": "waitFor",
      "text": "Use your question tool now to ask me which color to use. Ask exactly one question with options Blue and Green. Do not answer it yourself. After my answer, reply with only COLOR-CHOICE-DONE.",
      "within": "chat.composer.input",
      "absent": true,
      "timeout": 300
    },
    {
      "action": "waitFor",
      "identifier": "chat.question.0.0.option.0",
      "timeout": 300
    },
    {
      "action": "screenshot",
      "name": "local-question"
    },
    {
      "action": "press",
      "identifier": "chat.question.0.0.option.0"
    },
    {
      "action": "waitFor",
      "identifier": "chat.request.0.submit",
      "enabled": true,
      "timeout": 300
    },
    {
      "action": "press",
      "identifier": "chat.request.0.submit"
    },
    {
      "action": "waitFor",
      "identifier": "chat.request.0.submit",
      "absent": true,
      "timeout": 300
    },
    {
      "action": "waitFor",
      "text": "COLOR-CHOICE-DONE",
      "within": "chat.transcript",
      "timeout": 300
    },
    {
      "action": "waitFor",
      "identifier": "chat.composer.stop",
      "absent": true,
      "timeout": 300
    },
    {
      "action": "press",
      "identifier": "chat.provider.claude"
    },
    {
      "action": "waitFor",
      "identifier": "chat.composer.send",
      "enabled": true,
      "timeout": 180
    },
    {
      "action": "type",
      "text": "Which word did Local reply with? Reply with only that word."
    },
    {
      "action": "press",
      "identifier": "chat.composer.send"
    },
    {
      "action": "waitFor",
      "text": "Which word did Local reply with? Reply with only that word.",
      "within": "chat.composer.input",
      "absent": true,
      "timeout": 15
    },
    {
      "action": "waitFor",
      "text": "Sign in to Claude",
      "within": "chat.error",
      "timeout": 30
    },
    {
      "action": "waitFor",
      "identifier": "chat.signin",
      "timeout": 30
    },
    {
      "action": "screenshot",
      "name": "switching-claude-signin"
    },
    {
      "action": "dumpTree",
      "name": "switching-tree"
    }
  ]
}
