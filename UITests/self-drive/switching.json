{
  "steps": [
    {
      "action": "press",
      "identifier": "bubble.left.and.text.bubble.right"
    },
    {
      "action": "press",
      "identifier": "chat.new.$project"
    },
    {
      "action": "press",
      "identifier": "chat.provider.codex"
    },
    {
      "action": "type",
      "text": "Reply with only this word spelled backwards: nacilep"
    },
    {
      "action": "press",
      "identifier": "chat.composer.send"
    },
    {
      "action": "waitFor",
      "text": "Reply with only this word spelled backwards: nacilep",
      "within": "chat.composer.input",
      "absent": true,
      "timeout": 15
    },
    {
      "action": "waitFor",
      "text": "pelican",
      "within": "chat.transcript",
      "caseSensitive": true,
      "timeout": 180
    },
    {
      "action": "waitFor",
      "identifier": "chat.composer.stop",
      "timeout": 180,
      "absent": true
    },
    {
      "action": "dumpTree",
      "name": "before-local-switch",
      "delay": 3
    },
    {
      "action": "press",
      "identifier": "chat.provider.local"
    },
    {
      "action": "type",
      "text": "Which word did you just reply with? Reply with only that word, in capitals."
    },
    {
      "action": "press",
      "identifier": "chat.composer.send"
    },
    {
      "action": "waitFor",
      "text": "Which word did you just reply with? Reply with only that word, in capitals.",
      "within": "chat.composer.input",
      "absent": true,
      "timeout": 15
    },
    {
      "action": "waitFor",
      "text": "PELICAN",
      "within": "chat.transcript",
      "caseSensitive": true,
      "timeout": 180
    },
    {
      "action": "waitFor",
      "identifier": "chat.composer.stop",
      "timeout": 180,
      "absent": true
    },
    {
      "action": "type",
      "text": "Use your bash shell tool to run exactly: printf example > local-made.txt. Do not use an edit tool. Wait for approval."
    },
    {
      "action": "press",
      "identifier": "chat.composer.send"
    },
    {
      "action": "waitFor",
      "text": "Use your bash shell tool to run exactly: printf example > local-made.txt. Do not use an edit tool. Wait for approval.",
      "within": "chat.composer.input",
      "absent": true,
      "timeout": 15
    },
    {
      "action": "waitFor",
      "identifier": "chat.request.0.allow",
      "timeout": 180
    },
    {
      "action": "screenshot",
      "name": "local-approval"
    },
    {
      "action": "press",
      "identifier": "chat.request.0.allow"
    },
    {
      "action": "waitFor",
      "identifier": "chat.request.0.allow",
      "timeout": 30,
      "absent": true
    },
    {
      "action": "waitFor",
      "identifier": "chat.tool.completed",
      "within": "chat.transcript",
      "timeout": 180
    },
    {
      "action": "waitFor",
      "identifier": "chat.composer.stop",
      "timeout": 180,
      "absent": true
    },
    {
      "action": "press",
      "identifier": "chat.provider.claude"
    },
    {
      "action": "type",
      "text": "Which word did Local reply with? Reply with only that word."
    },
    {
      "action": "press",
      "identifier": "chat.composer.send"
    },
    {
      "action": "waitFor",
      "text": "Which word did Local reply with? Reply with only that word.",
      "within": "chat.composer.input",
      "absent": true,
      "timeout": 15
    },
    {
      "action": "waitFor",
      "text": "Sign in to Claude",
      "within": "chat.error",
      "timeout": 30
    },
    {
      "action": "waitFor",
      "identifier": "chat.signin",
      "timeout": 30
    },
    {
      "action": "screenshot",
      "name": "switching-claude-signin"
    },
    {
      "action": "dumpTree",
      "name": "switching-tree"
    }
  ]
}
