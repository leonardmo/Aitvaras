{
  "steps": [
    {"action": "press", "identifier": "bubble.left.and.text.bubble.right", "delay": 1},
    {"action": "waitFor", "identifier": "chat.composer.send", "enabled": true, "timeout": 30},
    {"action": "press", "identifier": "chat.mode"},
    {"action": "waitFor", "identifier": "chat.permissions.commands.ask", "enabled": true, "timeout": 10},
    {"action": "press", "identifier": "chat.permissions.commands.ask"},
    {"action": "press", "identifier": "chat.mode"},
    {"action": "waitFor", "identifier": "chat.composer.send", "enabled": true, "timeout": 30},
    {"action": "type", "text": "Run sh check-failure.sh exactly once as a foreground shell command. After it finishes, reply with only FAILED-TURN-DONE."},
    {"action": "press", "identifier": "chat.composer.send"},
    {"action": "waitFor", "identifier": "chat.request.0.allow", "enabled": true, "timeout": 60},
    {"action": "press", "identifier": "chat.request.0.allow"},
    {"action": "waitFor", "text": "Running", "within": "chat.transcript", "timeout": 5},
    {"action": "screenshot", "name": "01-running", "delay": 0.4},
    {"action": "dumpTree", "name": "01-running"},
    {"action": "waitFor", "identifier": "chat.stop", "absent": true, "timeout": 60},
    {"action": "waitFor", "text": "2 passed, 1 failed", "within": "chat.transcript", "timeout": 10},
    {"action": "screenshot", "name": "02-failure", "delay": 0.4},
    {"action": "dumpTree", "name": "02-failure"},
    {"action": "waitFor", "text": "FAILED-TURN-DONE", "within": "chat.transcript", "timeout": 15, "caseSensitive": true},
    {"action": "press", "text": "Full output", "within": "chat.transcript"},
    {"action": "waitFor", "text": "loads defaults", "within": "chat.transcript", "timeout": 5},
    {"action": "press", "text": "Show last lines", "within": "chat.transcript"},
    {"action": "waitFor", "identifier": "chat.composer.send", "enabled": true, "timeout": 30},
    {"action": "type", "text": "Run sh check-success.sh exactly once as a foreground shell command. After it finishes, reply with only RETRY-TURN-DONE."},
    {"action": "press", "identifier": "chat.composer.send"},
    {"action": "waitFor", "identifier": "chat.request.0.allow", "enabled": true, "timeout": 60},
    {"action": "press", "identifier": "chat.request.0.allow"},
    {"action": "waitFor", "identifier": "chat.stop", "absent": true, "timeout": 60},
    {"action": "waitFor", "text": "1 command succeeded", "within": "chat.transcript", "timeout": 10},
    {"action": "screenshot", "name": "03-retry", "delay": 0.4},
    {"action": "dumpTree", "name": "03-retry"},
    {"action": "waitFor", "text": "RETRY-TURN-DONE", "within": "chat.transcript", "timeout": 15, "caseSensitive": true},
    {"action": "press", "text": "sh check-success.sh", "within": "chat.transcript"},
    {"action": "waitFor", "text": "3 passed, 0 failed", "within": "chat.transcript", "timeout": 5},
    {"action": "screenshot", "name": "04-success-open", "delay": 0.4},
    {"action": "press", "text": "sh check-success.sh", "within": "chat.transcript"},
    {"action": "waitFor", "text": "3 passed, 0 failed", "within": "chat.transcript", "absent": true, "timeout": 5},
    {"action": "screenshot", "name": "05-success-closed", "delay": 0.4}
  ]
}
