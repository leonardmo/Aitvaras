{
  "steps": [
    { "action": "press", "identifier": "bubble.left.and.text.bubble.right", "delay": 3 },
    { "action": "press", "identifier": "chat.new.unassigned" },
    { "action": "waitFor", "identifier": "chat.composer.input", "timeout": 10 },
    { "action": "screenshot", "name": "layout-01-new-chat", "delay": 2 },
    { "action": "press", "identifier": "sidebar.left" },
    { "action": "waitFor", "identifier": "chat.provider.codex", "timeout": 10, "delay": 1, "optional": true },
    { "action": "press", "identifier": "chat.provider.codex", "optional": true },
    { "action": "press", "identifier": "sidebar.left", "delay": 1 },
    { "action": "waitFor", "identifier": "chat.composer.input", "timeout": 10 },
    { "action": "type", "text": "Reply with only this word spelled backwards: nacilep" },
    { "action": "press", "identifier": "chat.composer.send" },
    { "action": "waitFor", "text": "Reply with only this word spelled backwards: nacilep", "within": "chat.composer.input", "absent": true, "timeout": 15 },
    { "action": "waitFor", "text": "pelican", "within": "chat.transcript", "timeout": 90, "optional": true },
    { "action": "screenshot", "name": "layout-02-codex-reply", "delay": 3 },
    { "action": "press", "identifier": "chat.new.$project" },
    { "action": "waitFor", "identifier": "chat.composer.input", "timeout": 10 },
    { "action": "press", "identifier": "sidebar.left" },
    { "action": "waitFor", "identifier": "chat.provider.claude", "timeout": 10, "delay": 1, "optional": true },
    { "action": "press", "identifier": "chat.provider.claude", "optional": true },
    { "action": "press", "identifier": "sidebar.left", "delay": 1 },
    { "action": "waitFor", "identifier": "chat.composer.input", "timeout": 10 },
    { "action": "type", "text": "Reply with only this word spelled backwards: nacilep" },
    { "action": "press", "identifier": "chat.composer.send" },
    { "action": "waitFor", "text": "Reply with only this word spelled backwards: nacilep", "within": "chat.composer.input", "absent": true, "timeout": 15 },
    { "action": "waitFor", "text": "Sign in to Claude", "within": "chat.error", "timeout": 30, "optional": true },
    { "action": "waitFor", "identifier": "chat.signin", "within": "chat.error", "timeout": 10, "optional": true },
    { "action": "screenshot", "name": "layout-03-claude-signin", "delay": 2 },
    { "action": "press", "identifier": "gearshape" },
    { "action": "waitFor", "identifier": "settings.providers", "timeout": 10 },
    { "action": "screenshot", "name": "layout-04-setup", "delay": 2 },
    { "action": "press", "identifier": "settings.providers" },
    { "action": "waitFor", "identifier": "settings.providers.page", "timeout": 10 },
    { "action": "screenshot", "name": "layout-05-providers", "delay": 2 }
  ]
}
