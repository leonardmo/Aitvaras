  },
  {
   "action": "press",
   "identifier": "chat.provider.claude"
  },
  {
   "action": "waitFor",
   "text": "Haiku",
   "within": "chat.model",
   "timeout": 30
  },
  {
   "action": "press",
   "identifier": "chat.agent.done"
  },
  {
   "action": "waitFor",
   "identifier": "chat.composer.send",
   "enabled": true,
   "timeout": 180
  },
  {
   "action": "type",
   "text": "Use your Bash tool three separate times, one command per call, in this order: echo one, then echo blocked-example, then echo three. If a command is blocked, do not retry it; continue with the next. Afterwards reply with only DONE-HOOKS."
  },
  {
   "action": "press",
   "identifier": "chat.composer.send"
  },
  {
   "action": "waitFor",
   "text": "Use your Bash tool three separate times, one command per call, in this order: echo one, then echo blocked-example, then echo three. If a command is blocked, do not retry it; continue with the next. Afterwards reply with only DONE-HOOKS.",
