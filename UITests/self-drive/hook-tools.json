   "absent": true,
   "timeout": 15
  },
  {
   "action": "waitFor",
   "identifier": "chat.request.0.allow",
   "enabled": true,
   "timeout": 90,
   "optional": true
  },
  {
   "action": "press",
   "identifier": "chat.request.0.allow",
   "optional": true
  },
  {
   "action": "waitFor",
   "identifier": "chat.request.0.allow",
   "enabled": true,
   "timeout": 90,
   "optional": true
  },
  {
   "action": "press",
   "identifier": "chat.request.0.allow",
   "optional": true
  },
  {
   "action": "waitFor",
   "identifier": "chat.request.0.allow",
   "enabled": true,
   "timeout": 90,
   "optional": true
  },
  {
   "action": "press",
   "identifier": "chat.request.0.allow",
   "optional": true
  },
  {
   "action": "waitFor",
   "identifier": "chat.request.0.allow",
   "enabled": true,
   "timeout": 90,
   "optional": true
  },
  {
   "action": "press",
   "identifier": "chat.request.0.allow",
   "optional": true
  },
  {
   "action": "waitFor",
   "text": "DONE-HOOKS",
   "within": "chat.transcript",
   "caseSensitive": true,
   "timeout": 240
  },
  {
   "action": "waitFor",
   "identifier": "chat.composer.stop",
   "absent": true,
   "timeout": 180
  },
  {
   "action": "waitFor",
   "identifier": "chat.error",
   "absent": true,
   "timeout": 0
  },
  {
   "action": "waitFor",
