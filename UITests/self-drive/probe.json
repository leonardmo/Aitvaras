{
  "steps": [
    {
      "action": "dumpTree",
      "name": "probe-launch-tree",
      "delay": 1
    },
    {
      "action": "press",
      "identifier": "bubble.left.and.text.bubble.right"
    },
    {
      "action": "waitFor",
      "identifier": "chat.composer.input",
      "timeout": 10
    },
    {
      "action": "type",
      "text": "Self-drive probe \ud83d\udc09"
    },
    {
      "action": "waitFor",
      "text": "Self-drive probe \ud83d\udc09",
      "timeout": 5
    },
    {
      "action": "screenshot",
      "name": "probe-composer"
    },
    {
      "action": "press",
      "identifier": "chat.composer.send"
    },
    {
      "action": "screenshot",
      "name": "probe-sent",
      "delay": 3
    },
    {
      "action": "dumpTree",
      "name": "probe-composer-tree"
    }
  ]
}
