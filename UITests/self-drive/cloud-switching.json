{
 "steps": [
  {
   "action": "press",
   "identifier": "bubble.left.and.text.bubble.right"
  },
  {
   "action": "press",
   "identifier": "chat.new.$project"
  },
  {
   "action": "waitFor",
   "identifier": "chat.agent",
   "enabled": true,
   "timeout": 300
  },
  {
   "action": "press",
   "identifier": "chat.agent"
  },
  {
   "action": "waitFor",
   "identifier": "chat.provider.codex",
   "enabled": true,
   "timeout": 180
  },
  {
   "action": "press",
   "identifier": "chat.provider.codex"
  },
  {
   "action": "press",
   "identifier": "chat.agent.done"
  },
  {
   "action": "waitFor",
   "identifier": "chat.composer.send",
   "enabled": true,
   "timeout": 180
  },
  {
   "action": "type",
   "text": "Reply with only this word spelled backwards: nacilep"
  },
  {
   "action": "press",
   "identifier": "chat.composer.send"
  },
  {
   "action": "waitFor",
   "text": "Reply with only this word spelled backwards: nacilep",
